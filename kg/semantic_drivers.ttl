@prefix iot: <http://example.org/iot#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

iot:Model_LoRa_TempHum a iot:DeviceModel ;
  iot:usesCodec iot:Codec_LoRa_TH ;
  iot:hasFieldMapping iot:Map_LoRa_temp, iot:Map_LoRa_hum .

iot:Model_ZigBee_TempHum a iot:DeviceModel ;
  iot:usesCodec iot:Codec_ZigBee_TH ;
  iot:hasFieldMapping iot:Map_ZB_temp, iot:Map_ZB_hum .

iot:Model_BLE_TempHum a iot:DeviceModel ;
  iot:usesCodec iot:Codec_BLE_TH ;
  iot:hasFieldMapping iot:Map_BLE_temp, iot:Map_BLE_hum .

iot:Codec_LoRa_TH a iot:Codec ; iot:codecName "lora_th_v1" .
iot:Codec_ZigBee_TH a iot:Codec ; iot:codecName "zigbee_th_v1" .
iot:Codec_BLE_TH a iot:Codec ; iot:codecName "ble_th_v1" .

iot:Map_LoRa_temp a iot:FieldMapping ;
  iot:rawKey "temp" ; iot:unifiedKey "temperature" ; iot:unit "°C" ;
  iot:scale "0.01"^^xsd:float ; iot:min "-50"^^xsd:float ; iot:max "150"^^xsd:float .
iot:Map_LoRa_hum a iot:FieldMapping ;
  iot:rawKey "hum" ; iot:unifiedKey "humidity" ; iot:unit "%" ;
  iot:scale "0.1"^^xsd:float ; iot:min "0"^^xsd:float ; iot:max "100"^^xsd:float .

iot:Map_ZB_temp a iot:FieldMapping ;
  iot:rawKey "t" ; iot:unifiedKey "temperature" ; iot:unit "°C" ;
  iot:scale "0.01"^^xsd:float ; iot:min "-40"^^xsd:float ; iot:max "125"^^xsd:float .
iot:Map_ZB_hum a iot:FieldMapping ;
  iot:rawKey "h" ; iot:unifiedKey "humidity" ; iot:unit "%" ;
  iot:scale "0.1"^^xsd:float ; iot:min "0"^^xsd:float ; iot:max "100"^^xsd:float .

iot:Map_BLE_temp a iot:FieldMapping ;
  iot:rawKey "temperature" ; iot:unifiedKey "temperature" ; iot:unit "°C" ;
  iot:scale "1.0"^^xsd:float ; iot:min "-40"^^xsd:float ; iot:max "85"^^xsd:float .
iot:Map_BLE_hum a iot:FieldMapping ;
  iot:rawKey "humidity" ; iot:unifiedKey "humidity" ; iot:unit "%" ;
  iot:scale "1.0"^^xsd:float ; iot:min "0"^^xsd:float ; iot:max "100"^^xsd:float .
