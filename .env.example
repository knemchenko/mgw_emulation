# Example environment configuration for MGW emulation experiments.
# Copy to ".env" and adjust values as needed.

# Number of application subscribers (A)
APP_COUNT=10

# UNS mode: 0 (publish once to mgw/... and broker performs fan-out)
# P2P mode: 1 (gateway duplicates publish per app to mgw_p2p/appN/...)
P2P_MODE=0

# Decoder mode inside Semantic Core:
# - ontology: ontology-driven "semantic driver" decoding (default)
# - hardcoded: hardcoded decoding baseline
DECODER_MODE=ontology

# Fixed experiment duration (seconds).
# The proto generators and subscribers run for this duration and then exit.
RUN_DURATION_SEC=60

# Optional: delay (seconds) before proto generators start sending frames.
# Helps ensure subscribers are connected before traffic starts.
START_DELAY_SEC=2
